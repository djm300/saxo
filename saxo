#!/usr/bin/env python3
import sys


def main():
    if len(sys.argv) < 2:
        print("Usage: python3 saxo <command> [options]")
        raise SystemExit(2)

    # Re-dispatch every command, including ``serve``, through the unified CLI
    # so authentication happens before the web server is started.
    sys.argv = [sys.argv[0]] + sys.argv[1:]
    try:
        from cli.saxocli import main as cli_main
    except ImportError as exc:
        raise SystemExit(f"Missing dependency for CLI mode: {exc}")

    return cli_main()


if __name__ == "__main__":
    raise SystemExit(main())
